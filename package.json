    "packages/convict"
  ],
  "devDependencies": {
    "coveralls": "3.1.1",
    "deep-object-diff": "1.1.9",
    "eslint": "7.26.0",
    "jest": "26.6.3",
    "js-yaml": "4.1.0",
    "json5": "2.2.3",
    "toml": "3.0.0"
  },
  "packageManager": "yarn@4.10.3"
